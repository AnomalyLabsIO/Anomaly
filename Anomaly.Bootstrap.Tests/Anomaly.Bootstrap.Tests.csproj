<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit" Version="2.7.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.7" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Anomaly.Bootstrap\Anomaly.Bootstrap.csproj" AdditionalProperties="DeployLocal=false" />
    <Reference Include="MelonLoader" HintPath="$(AnomalyClientMelonLibDir)\MelonLoader.dll" Private="true" />
    <Reference Include="0Harmony" HintPath="$(AnomalyClientMelonLibDir)\0Harmony.dll" Private="true" />
    <Reference Include="MonoMod.RuntimeDetour" HintPath="$(AnomalyClientMelonLibDir)\MonoMod.RuntimeDetour.dll" Private="true" />
    <Reference Include="MonoMod.Utils" HintPath="$(AnomalyClientMelonLibDir)\MonoMod.Utils.dll" Private="true" />
    <Reference Include="Mono.Cecil" HintPath="$(AnomalyClientMelonLibDir)\Mono.Cecil.dll" Private="true" />
    <AssemblyMetadata Include="AnomalyClientInteropDir" Value="$(AnomalyClientInteropDir)" />
    <AssemblyMetadata Include="AnomalyServerReferenceDir" Value="$(AnomalyServerReferenceDir)" />
  </ItemGroup>
</Project>
