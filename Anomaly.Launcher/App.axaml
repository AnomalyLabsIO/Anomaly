<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Anomaly.Launcher.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Containment Terminal — Direction B design tokens -->
            <SolidColorBrush x:Key="Bg0" Color="#0A0B0D" />
            <SolidColorBrush x:Key="Bg1" Color="#101216" />
            <SolidColorBrush x:Key="Bg2" Color="#171A20" />
            <SolidColorBrush x:Key="Bg3" Color="#1E222A" />
            <SolidColorBrush x:Key="Line" Color="#252A33" />
            <SolidColorBrush x:Key="LineSoft" Color="#1C2029" />
            <SolidColorBrush x:Key="LineHover" Color="#3A4048" />
            <SolidColorBrush x:Key="Text" Color="#E7E9EE" />
            <SolidColorBrush x:Key="TextDim" Color="#8A8F9A" />
            <SolidColorBrush x:Key="TextMute" Color="#5A606B" />
            <SolidColorBrush x:Key="Accent" Color="#E23B3B" />
            <SolidColorBrush x:Key="AccentHover" Color="#C93333" />
            <SolidColorBrush x:Key="AccentDim" Color="#8A1F1F" />
            <SolidColorBrush x:Key="AccentSoft" Color="#1AE23B3B" />
            <SolidColorBrush x:Key="Ok" Color="#4ADE80" />
            <SolidColorBrush x:Key="OkSoft" Color="#0A4ADE80" />
            <SolidColorBrush x:Key="OkBorder" Color="#404ADE80" />
            <SolidColorBrush x:Key="Warn" Color="#F59E0B" />
            <SolidColorBrush x:Key="Err" Color="#E23B3B" />
            <SolidColorBrush x:Key="Transparent" Color="Transparent" />

            <!-- Fonts -->
            <FontFamily x:Key="FontMono">Consolas,Cascadia Mono,Menlo,Monospace,$Default</FontFamily>
            <FontFamily x:Key="FontUi">Inter,Segoe UI,$Default</FontFamily>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- ===================== Global ===================== -->
        <Style Selector="Window">
            <Setter Property="Background" Value="{StaticResource Bg0}" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        </Style>

        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        </Style>

        <!-- ===================== Chip ===================== -->
        <Style Selector="Border.chip">
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.chip > TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="LetterSpacing" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        </Style>
        <Style Selector="Border.chip.ok">
            <Setter Property="BorderBrush" Value="#404ADE80" />
            <Setter Property="Background" Value="#0F4ADE80" />
        </Style>
        <Style Selector="Border.chip.ok > TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ok}" />
        </Style>
        <Style Selector="Border.chip.warn">
            <Setter Property="BorderBrush" Value="#40F59E0B" />
            <Setter Property="Background" Value="#0FF59E0B" />
        </Style>
        <Style Selector="Border.chip.warn > TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Warn}" />
        </Style>
        <Style Selector="Border.chip.err">
            <Setter Property="BorderBrush" Value="#4DE23B3B" />
            <Setter Property="Background" Value="#14E23B3B" />
        </Style>
        <Style Selector="Border.chip.err > TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
        </Style>
        <Style Selector="Border.chip.auth">
            <Setter Property="BorderBrush" Value="{StaticResource AccentDim}" />
            <Setter Property="Background" Value="#0FE23B3B" />
        </Style>
        <Style Selector="Border.chip.auth > TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="FontSize" Value="8" />
        </Style>
        <Style Selector="Border.chip.dim">
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.chip.small > TextBlock">
            <Setter Property="FontSize" Value="8" />
        </Style>
        <Style Selector="Border.chip.small">
            <Setter Property="Padding" Value="4,1" />
        </Style>

        <!-- ===================== Button ===================== -->
        <Style Selector="Button.al">
            <Setter Property="Background" Value="{StaticResource Bg2}" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        </Style>
        <Style Selector="Button.al:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Bg3}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineHover}" />
        </Style>
        <Style Selector="Button.al:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Bg3}" />
        </Style>
        <Style Selector="Button.al:disabled /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.45" />
        </Style>

        <Style Selector="Button.al.primary">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.al.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentHover}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentHover}" />
        </Style>

        <Style Selector="Button.al.ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        </Style>
        <Style Selector="Button.al.ghost:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Bg2}" />
        </Style>

        <Style Selector="Button.al.danger">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentDim}" />
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
        </Style>
        <Style Selector="Button.al.danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#14E23B3B" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        </Style>

        <Style Selector="Button.al.small">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <!-- Tab button -->
        <Style Selector="Button.tab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,0" />
            <Setter Property="Padding" Value="24,14" />
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
            <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.tab TextBlock">
            <Setter Property="LetterSpacing" Value="1" />
        </Style>
        <Style Selector="Button.tab:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Bg2}" />
        </Style>
        <Style Selector="Button.tab.active">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="{StaticResource Bg0}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="BorderThickness" Value="0,2,0,0" />
        </Style>
        <Style Selector="Button.tab.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Bg0}" />
        </Style>

        <!-- ===================== TextBox ===================== -->
        <Style Selector="TextBox.al">
            <Setter Property="Background" Value="{StaticResource Bg0}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
            <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="MinHeight" Value="28" />
        </Style>
        <Style Selector="TextBox.al:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        </Style>
        <Style Selector="TextBox.al /template/ TextBlock#PART_Watermark">
            <Setter Property="Foreground" Value="{StaticResource TextMute}" />
        </Style>
        <Style Selector="TextBox.al /template/ TextBlock#PART_FloatingWatermark">
            <Setter Property="Foreground" Value="{StaticResource TextMute}" />
        </Style>

        <!-- ===================== CheckBox (.chk) ===================== -->
        <Style Selector="CheckBox.chk">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="CheckBox.chk /template/ Border#NormalRectangle">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="{StaticResource Bg2}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="CheckBox.chk:checked /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        </Style>
        <Style Selector="CheckBox.chk /template/ Path#CheckGlyph">
            <Setter Property="Stroke" Value="White" />
            <Setter Property="StrokeThickness" Value="1.5" />
        </Style>

        <!-- ===================== RadioButton ===================== -->
        <Style Selector="RadioButton.al">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- ===================== ListBox / list rows ===================== -->
        <Style Selector="ListBox.al">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.al ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.al ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.al ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.al ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- ===================== ScrollBar ===================== -->
        <Style Selector="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ScrollBar:vertical /template/ Thumb">
            <Setter Property="Background" Value="#2A2F38" />
        </Style>

    </Application.Styles>
</Application>
