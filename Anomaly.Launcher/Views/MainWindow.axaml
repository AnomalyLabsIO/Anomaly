<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Anomaly.Launcher.ViewModels"
        xmlns:conv="using:Anomaly.Launcher.Converters"
        xmlns:l="using:Anomaly.Launcher.Markup"
        x:Class="Anomaly.Launcher.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Anomaly Launcher"
        Icon="/Assets/AnomalyLogo.png"
        Width="900" Height="600"
        MinWidth="700" MinHeight="450"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True">

    <Window.Resources>
        <conv:BoolToColorConverter x:Key="RunningColorConverter"
                                   TrueBrush="#4CAF50" FalseBrush="#616161" />
    </Window.Resources>

    <DockPanel>
        <!-- Top Bar -->
        <Border DockPanel.Dock="Top" Padding="16,10" Background="#1E1E2E">
            <DockPanel>
                <!-- Username: display mode -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                            IsVisible="{Binding !IsEditingUsername}">
                    <TextBlock Text="{l:Tr launcher.mainwindow.welcome_prefix}" FontSize="16" FontWeight="SemiBold"
                               VerticalAlignment="Center" Opacity="0.7" />
                    <Button Content="{Binding Username}"
                            Command="{Binding BeginEditUsernameCommand}"
                            FontSize="16" FontWeight="SemiBold"
                            Padding="4,0" Margin="-4,0,0,0"
                            Background="Transparent"
                            Cursor="Hand"
                            ToolTip.Tip="{l:Tr launcher.mainwindow.username_tooltip}">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{l:Tr launcher.mainwindow.username_copy_user_id}"
                                          Command="{Binding CopyUserIdCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>

                <!-- Username: edit mode -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="6"
                            IsVisible="{Binding IsEditingUsername}"
                            VerticalAlignment="Center">
                    <TextBlock Text="{l:Tr launcher.mainwindow.username_label}" FontSize="14" VerticalAlignment="Center" Opacity="0.7" />
                    <TextBox Text="{Binding EditingUsernameText}"
                             Width="180" FontSize="14"
                             Watermark="{l:Tr launcher.mainwindow.username_watermark}"
                             x:Name="UsernameTextBox" />
                    <Button Content="{l:Tr launcher.mainwindow.username_save}" Command="{Binding SaveUsernameCommand}"
                            Padding="10,4" FontSize="12" Classes="accent" />
                    <Button Content="{l:Tr launcher.mainwindow.username_cancel}" Command="{Binding CancelEditUsernameCommand}"
                            Padding="10,4" FontSize="12" />
                </StackPanel>

                <Panel /> <!-- Spacer -->
            </DockPanel>
        </Border>

        <!-- Bottom Bar -->
        <Border DockPanel.Dock="Bottom" Padding="12,8" Background="#1E1E2E">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8">
                    <Button Content="{l:Tr launcher.mainwindow.launch_vanilla}"
                            Command="{Binding LaunchVanillaCommand}"
                            IsEnabled="{Binding CanLaunch}"
                            Padding="16,8" />
                    <Button Content="{l:Tr launcher.mainwindow.launch_modded}"
                            Command="{Binding LaunchModdedCommand}"
                            IsEnabled="{Binding CanLaunch}"
                            Padding="16,8"
                            Classes="accent" />
                    <Button Content="{l:Tr launcher.mainwindow.kill_game}"
                            Command="{Binding KillGameCommand}"
                            IsVisible="{Binding IsGameRunning}"
                            Padding="16,8"
                            Classes="danger" />
                    <Button Content="{l:Tr launcher.mainwindow.refresh}"
                            Command="{Binding RefreshStateCommand}"
                            Padding="16,8" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10"
                             Fill="{Binding IsGameRunning, Converter={StaticResource RunningColorConverter}}" />
                    <TextBlock Text="{Binding GameStatusText}"
                               FontSize="12" VerticalAlignment="Center" Opacity="0.8" />
                </StackPanel>

                <!-- Launch Args -->
                <TextBox Text="{Binding LaunchArgs}"
                         Watermark="{l:Tr launcher.mainwindow.launch_args_watermark}"
                         FontSize="11" Margin="8,0"
                         VerticalAlignment="Center"
                         ToolTip.Tip="{l:Tr launcher.mainwindow.launch_args_tooltip}" />
            </DockPanel>
        </Border>

        <!-- Main Content -->
        <Grid ColumnDefinitions="280,*">
            <!-- Left Panel: Mod List -->
            <Border Grid.Column="0" BorderBrush="#333" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{l:Tr launcher.mainwindow.mods_header}" FontSize="14" FontWeight="SemiBold"
                               Margin="12,10" />
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Mods}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ModItemViewModel">
                                    <Border Padding="12,6" BorderBrush="#333" BorderThickness="0,0,0,1">
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Left"
                                                      IsChecked="{Binding IsActive}"
                                                      IsEnabled="{Binding CanToggle}"
                                                      VerticalAlignment="Center" />
                                            <StackPanel Margin="8,0,0,0">
                                                <DockPanel>
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="13" FontWeight="Medium" />
                                                    <TextBlock Text="{Binding VersionText, StringFormat=' v{0}'}"
                                                               FontSize="11" Opacity="0.6"
                                                               VerticalAlignment="Center" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding TargetGameVersion, StringFormat='Target: {0}'}"
                                                           FontSize="10" Opacity="0.5"
                                                           IsVisible="{Binding TargetGameVersion, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                <TextBlock Text="{Binding VersionWarningText}"
                                                           FontSize="10" Foreground="#FF9800"
                                                           IsVisible="{Binding IsVersionMismatch}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Right Panel: State + Info -->
            <ScrollViewer Grid.Column="1">
                <StackPanel Margin="16,10" Spacing="16">

                    <!-- ========== State 1: Game Not Installed ========== -->
                    <StackPanel Spacing="12" IsVisible="{Binding IsGameNotInstalled}">
                        <TextBlock Text="{l:Tr launcher.state1.header}" FontSize="16" FontWeight="SemiBold" />

                        <!-- Drop zone -->
                        <Border Background="#1A1A2E" CornerRadius="6" Padding="24"
                                BorderBrush="#555" BorderThickness="2"
                                x:Name="DropZone"
                                MinHeight="100">
                            <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{l:Tr launcher.state1.drop_zone_primary}"
                                           FontSize="14" HorizontalAlignment="Center" Opacity="0.7" />
                                <TextBlock Text="{l:Tr launcher.state1.drop_zone_secondary}"
                                           FontSize="11" HorizontalAlignment="Center" Opacity="0.5" />
                            </StackPanel>
                        </Border>

                        <!-- Manual path entry -->
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{l:Tr launcher.state1.set_path}"
                                    Command="{Binding SetVanillaPathCommand}"
                                    Padding="12,6" Margin="8,0,0,0" />
                            <TextBox Text="{Binding ManualVanillaPath}"
                                     Watermark="{l:Tr launcher.state1.path_watermark}"
                                     FontSize="12" />
                        </DockPanel>

                        <!-- Install Game button -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{l:Tr launcher.state1.install_game}"
                                    Command="{Binding InstallGameCommand}"
                                    Padding="16,8" FontSize="13" />
                            <Button Content="{l:Tr launcher.steamdl.entry.game_not_installed}"
                                    Command="{Binding OpenSteamDownloadDialogCommand}"
                                    Padding="16,8" FontSize="13" />
                        </StackPanel>
                    </StackPanel>

                    <!-- ========== State 2: Vanilla Updated ========== -->
                    <Border Background="#33FF9800" CornerRadius="6" Padding="16"
                            IsVisible="{Binding IsVanillaUpdated}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{l:Tr launcher.state2.header}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="#FF9800" />
                            <TextBlock Text="{l:Tr launcher.state2.body}"
                                       FontSize="12" TextWrapping="Wrap" Opacity="0.9" />
                            <Button Content="{l:Tr launcher.state2.sync_anomaly}"
                                    Command="{Binding SyncAnomalyCommand}"
                                    IsEnabled="{Binding HasInstallerAvailable}"
                                    Padding="16,8" Classes="accent"
                                    HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <!-- ========== State 3: Online Build Mismatch ========== -->
                    <Border Background="#334FC3F7" CornerRadius="6" Padding="16"
                            IsVisible="{Binding IsOnlineBuildMismatch}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{l:Tr launcher.state3.header}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="#4FC3F7" />
                            <StackPanel Spacing="2">
                                <TextBlock FontSize="12" Opacity="0.9">
                                    <Run Text="{l:Tr launcher.state3.your_build}" />
                                    <Run Text="{Binding LocalBuildId}" FontWeight="SemiBold" />
                                </TextBlock>
                                <TextBlock FontSize="12" Opacity="0.9">
                                    <Run Text="{l:Tr launcher.state3.latest_build}" />
                                    <Run Text="{Binding OnlineBuildId}" FontWeight="SemiBold" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="{l:Tr launcher.state3.update}"
                                        Command="{Binding UpdateScpslCommand}"
                                        Padding="16,8" Classes="accent" />
                                <Button Content="{l:Tr launcher.steamdl.entry.pin_older_build}"
                                        Command="{Binding OpenSteamDownloadDialogCommand}"
                                        Padding="16,8" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ========== State 4: All Good ========== -->
                    <Border Background="#334CAF50" CornerRadius="6" Padding="16"
                            IsVisible="{Binding IsAllGood}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{l:Tr launcher.state4.header}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="#4CAF50" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="{l:Tr launcher.state4.validate_files}"
                                        Command="{Binding ValidateGameFilesCommand}"
                                        Padding="12,6" />
                                <Button Content="{l:Tr launcher.state4.sync_anomaly}"
                                        Command="{Binding SyncAnomalyCommand}"
                                        IsEnabled="{Binding HasInstallerAvailable}"
                                        Padding="12,6" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ========== Info Panel (visible when game is installed) ========== -->
                    <Border Background="#1A1A2E" CornerRadius="6" Padding="16"
                            IsVisible="{Binding IsGameInstalled}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{l:Tr launcher.info.header}" FontSize="13" FontWeight="SemiBold" Opacity="0.8" />

                            <Grid ColumnDefinitions="170,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,4,0,0">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{l:Tr launcher.info.branch}"
                                           FontSize="12" Opacity="0.6" />
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{Binding Branch}"
                                           FontSize="12" FontWeight="Medium" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{l:Tr launcher.info.local_build_id}"
                                           FontSize="12" Opacity="0.6" Margin="0,6,0,0" />
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Text="{Binding LocalBuildId}"
                                           FontSize="12" FontWeight="Medium" Margin="0,6,0,0" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{l:Tr launcher.info.online_build_id}"
                                           FontSize="12" Opacity="0.6" Margin="0,6,0,0" />
                                <TextBlock Grid.Row="2" Grid.Column="1"
                                           Text="{Binding OnlineBuildId}"
                                           FontSize="12" FontWeight="Medium" Margin="0,6,0,0" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="{l:Tr launcher.info.melonloader}"
                                           FontSize="12" Opacity="0.6" Margin="0,6,0,0" />
                                <TextBlock Grid.Row="3" Grid.Column="1"
                                           Text="{Binding MelonLoaderVersion}"
                                           FontSize="12" FontWeight="Medium" Margin="0,6,0,0" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="{l:Tr launcher.info.vanilla_ga_date}"
                                           FontSize="12" Opacity="0.6" Margin="0,6,0,0" />
                                <TextBlock Grid.Row="4" Grid.Column="1"
                                           Text="{Binding VanillaGaDate}"
                                           FontSize="12" FontWeight="Medium" Margin="0,6,0,0" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="{l:Tr launcher.info.modded_ga_date}"
                                           FontSize="12" Opacity="0.6" Margin="0,6,0,0" />
                                <TextBlock Grid.Row="5" Grid.Column="1"
                                           Text="{Binding ModdedGaDate}"
                                           FontSize="12" FontWeight="Medium" Margin="0,6,0,0" />
                            </Grid>

                            <Button Content="{l:Tr launcher.steamdl.entry.change_version}"
                                    Command="{Binding OpenSteamDownloadDialogCommand}"
                                    Padding="12,6" Margin="0,8,0,0"
                                    HorizontalAlignment="Left" FontSize="11" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>

    <Window.Styles>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="#4CAF50" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#E53935" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Window.Styles>
</Window>
