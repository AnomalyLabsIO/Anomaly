diff --git a/src/Errors/DiagnosticFormatting.cs b/src/Errors/DiagnosticFormatting.cs
new file mode 100644
--- /dev/null
+++ b/src/Errors/DiagnosticFormatting.cs
@@ -0,0 +1,68 @@
+using System;
+using System.Text;
+
+namespace MoonSharp.Interpreter
+{
+    // Internal diagnostic formats use strings and bounded scalar arguments. This
+    // preflight also includes alignment/precision fields before String.Format
+    // allocates. Arbitrary host IFormattable implementations are a host boundary,
+    // not something this estimate can constrain.
+    internal static class DiagnosticFormatting
+    {
+        internal static string Format(string format, params object[] arguments)
+        {
+            if (MemoryBudget.Current == null) return string.Format(format, arguments);
+            if (arguments.Length != 0) MemoryBudget.TrackObject(arguments, 32L + 8L * arguments.Length);
+            long characters = format.Length;
+            for (int cursor = 0; cursor < format.Length; cursor++)
+            {
+                if (format[cursor] != '{') continue;
+                if (cursor + 1 < format.Length && format[cursor + 1] == '{') { cursor++; continue; }
+                cursor++;
+                long index = ReadNumber(format, ref cursor);
+                if (index < 0 || index >= arguments.Length) continue; // Let String.Format report invalid formats.
+                object argument = arguments[(int)index];
+                long size = argument is string text ? text.Length : 1024;
+                if (argument == null) size = 0;
+                while (cursor < format.Length && format[cursor] == ' ') cursor++;
+                if (cursor < format.Length && format[cursor] == ',')
+                {
+                    cursor++;
+                    while (cursor < format.Length && format[cursor] == ' ') cursor++;
+                    if (cursor < format.Length && (format[cursor] == '-' || format[cursor] == '+')) cursor++;
+                    size = Math.Max(size, ReadNumber(format, ref cursor));
+                }
+                while (cursor < format.Length && format[cursor] != '}')
+                {
+                    if (format[cursor] >= '0' && format[cursor] <= '9')
+                    {
+                        // Standard numeric precision can request a very large
+                        // output with a short format (for example F999999999).
+                        long precision = ReadNumber(format, ref cursor);
+                        if (!(argument is string)) size = Math.Max(size, precision + 1024);
+                    }
+                    else cursor++;
+                }
+                characters += size + format.Length;
+            }
+            // String.Format's growable formatter may rent temporary storage
+            // from a process-wide pool. Use an explicitly reserved, pre-sized
+            // builder instead, and give its copied result an independent lease.
+            var builder = MemoryBudget.Allocate(128L + 4L * characters,
+                () => new StringBuilder(checked((int)characters)));
+            builder.AppendFormat(format, arguments);
+            return MemoryBudget.AllocateString(builder.Length, () => builder.ToString());
+        }
+
+        private static long ReadNumber(string format, ref int cursor)
+        {
+            long value = 0;
+            while (cursor < format.Length && format[cursor] >= '0' && format[cursor] <= '9')
+            {
+                value = Math.Min(int.MaxValue, value * 10 + format[cursor] - '0');
+                cursor++;
+            }
+            return value;
+        }
+    }
+}
