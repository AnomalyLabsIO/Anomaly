@@ -0,0 +1,16 @@
+using System;
+
+namespace MoonSharp.Interpreter
+{
+    /// <summary>A terminal host limit, deliberately outside Lua's catchable exception hierarchy.</summary>
+    public sealed class ScriptExecutionAbortedException : Exception
+    {
+        public ExecutionTerminationReason Reason { get; private set; }
+
+        public ScriptExecutionAbortedException(ExecutionTerminationReason reason)
+            : base("Script execution terminated: " + reason)
+        {
+            Reason = reason;
+        }
+    }
+}
