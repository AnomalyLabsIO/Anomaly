@@ -0,0 +1,113 @@
+using System;
+using System.Diagnostics;
+using System.Threading;
+
+namespace MoonSharp.Interpreter
+{
+    /// <summary>Host-owned, cumulative work/deadline limits. Never expose this object to Lua.</summary>
+    public sealed class ExecutionBudget
+    {
+        [ThreadStatic] private static ExecutionBudget _current;
+        internal static ExecutionBudget Current { get { return _current; } }
+        private readonly long _deadline;
+        private readonly int _maxCallDepth;
+        private long _remaining;
+        private int _reason;
+        private int _reentryDepth;
+
+        public ExecutionBudget(long instructionLimit, TimeSpan timeout, int maxCallDepth = 128)
+        {
+            if (instructionLimit <= 0) throw new ArgumentOutOfRangeException(nameof(instructionLimit));
+            if (timeout <= TimeSpan.Zero) throw new ArgumentOutOfRangeException(nameof(timeout));
+            if (maxCallDepth <= 0) throw new ArgumentOutOfRangeException(nameof(maxCallDepth));
+            _remaining = instructionLimit;
+            _maxCallDepth = maxCallDepth;
+            long now = Stopwatch.GetTimestamp();
+            double ticks = timeout.TotalSeconds * Stopwatch.Frequency;
+            _deadline = ticks >= long.MaxValue - now ? long.MaxValue : now + Math.Max(1, (long)ticks);
+        }
+
+        public bool IsTerminated { get { return Volatile.Read(ref _reason) != 0; } }
+        public ExecutionTerminationReason TerminationReason { get { return (ExecutionTerminationReason)Volatile.Read(ref _reason); } }
+
+        public void Check()
+        {
+            MemoryBudget.Current?.Check();
+            var reason = TerminationReason;
+            if (reason != ExecutionTerminationReason.None) throw new ScriptExecutionAbortedException(reason);
+            if (Stopwatch.GetTimestamp() >= _deadline) Abort(ExecutionTerminationReason.Deadline);
+        }
+
+        public void Charge(long work = 1)
+        {
+            if (work < 0) throw new ArgumentOutOfRangeException(nameof(work));
+            Check();
+            if (Interlocked.Add(ref _remaining, -work) < 0) Abort(ExecutionTerminationReason.CpuLimit);
+        }
+
+        public void Cancel()
+        {
+            Interlocked.CompareExchange(ref _reason, (int)ExecutionTerminationReason.Cancelled, 0);
+        }
+
+        internal void CheckCallDepth(int depth)
+        {
+            Check();
+            if (depth > _maxCallDepth) Abort(ExecutionTerminationReason.DepthLimit);
+        }
+
+        internal void Enter()
+        {
+            Check();
+            if (Interlocked.Increment(ref _reentryDepth) > _maxCallDepth)
+            {
+                Interlocked.Decrement(ref _reentryDepth);
+                Abort(ExecutionTerminationReason.DepthLimit);
+            }
+        }
+
+        internal void Leave()
+        {
+            Interlocked.Decrement(ref _reentryDepth);
+        }
+
+        internal Scope EnterScope()
+        {
+            Enter();
+            return new Scope(this);
+        }
+
+        internal readonly struct Scope : IDisposable
+        {
+            private readonly ExecutionBudget _budget;
+            private readonly ExecutionBudget _previous;
+            internal Scope(ExecutionBudget budget)
+            {
+                _budget = budget;
+                _previous = _current;
+                _current = budget;
+            }
+            public void Dispose()
+            {
+                _current = _previous;
+                _budget.Leave();
+            }
+        }
+
+        internal void Abort(ExecutionTerminationReason reason)
+        {
+            Interlocked.CompareExchange(ref _reason, (int)reason, 0);
+            throw new ScriptExecutionAbortedException(TerminationReason);
+        }
+    }
+
+    public enum ExecutionTerminationReason
+    {
+        None,
+        CpuLimit,
+        Deadline,
+        DepthLimit,
+        Cancelled,
+        MemoryLimit
+    }
+}
diff --git a/src/Execution/MemoryBudget.cs b/src/Execution/MemoryBudget.cs
new file mode 100644
--- /dev/null
+++ b/src/Execution/MemoryBudget.cs
@@ -0,0 +1,285 @@
+using System;
+using System.Runtime.CompilerServices;
+using System.Threading;
+
+namespace MoonSharp.Interpreter
+{
+    /// <summary>Host-only conservative allocation accounting, not a CLR heap measurement.</summary>
+    public sealed class MemoryBudget
+    {
+        [ThreadStatic] private static MemoryBudget _current;
+        private const long RecordBytes = 256;
+        private const int MaximumRecords = 131072;
+        private readonly MemoryBudget _parent;
+        private readonly Registry _registry;
+        private ConditionalWeakTable<object, Allocation> _owners;
+        private long _charged, _total, _peak, _unbound;
+        private int _terminated;
+
+        public MemoryBudget(long allocationLimitBytes, MemoryBudget parent = null, bool reclaimable = false)
+        {
+            if (allocationLimitBytes <= 0) throw new ArgumentOutOfRangeException(nameof(allocationLimitBytes));
+            if (parent != null && parent.IsReclaimable != reclaimable)
+                throw new ArgumentException("Parent and child must use the same accounting mode.", nameof(parent));
+            Limit = allocationLimitBytes;
+            IsReclaimable = reclaimable;
+            _parent = parent;
+            _registry = parent?._registry ?? new Registry();
+        }
+
+        public long Limit { get; }
+        public bool IsReclaimable { get; }
+        public long ChargedBytes => Interlocked.Read(ref _charged);
+        public long TotalAllocatedBytes => Interlocked.Read(ref _total);
+        public long PeakBytes => Interlocked.Read(ref _peak);
+        public long UnboundBytes => Interlocked.Read(ref _unbound);
+        public int TrackedAllocationCount { get { lock (_registry) return _registry.Count; } }
+        public bool IsTerminated => Volatile.Read(ref _terminated) != 0 || (_parent?.IsTerminated ?? false);
+        public static MemoryBudget Current => _current;
+
+        public void Check()
+        {
+            if (IsTerminated) throw new ScriptExecutionAbortedException(ExecutionTerminationReason.MemoryLimit);
+        }
+
+        // Unknown lifetime remains charged. Reclaim requires an explicit backing owner.
+        public void Charge(long bytes) { ReserveBytes(bytes); }
+
+        private void ReserveBytes(long bytes)
+        {
+            if (bytes < 0) throw new ArgumentOutOfRangeException(nameof(bytes));
+            Check();
+            lock (_registry)
+            {
+                Check();
+                if (!CanReserve(bytes))
+                {
+                    if (IsReclaimable) SweepLocked(MaximumRecords);
+                    if (!CanReserve(bytes)) AbortDenied(bytes);
+                }
+                for (var budget = this; budget != null; budget = budget._parent)
+                {
+                    budget._charged += bytes;
+                    budget._unbound += bytes;
+                    budget._total = bytes > long.MaxValue - budget._total ? long.MaxValue : budget._total + bytes;
+                    budget._peak = Math.Max(budget._peak, budget._charged);
+                }
+            }
+        }
+
+        private bool CanReserve(long bytes)
+        {
+            for (var budget = this; budget != null; budget = budget._parent)
+                if (bytes > budget.Limit - budget._charged) return false;
+            return true;
+        }
+
+        private void AbortDenied(long bytes)
+        {
+            // Aggregate denial retires a requesting reclaimable VM, not its siblings.
+            var failed = this;
+            if (!IsReclaimable)
+                for (var budget = this; budget != null; budget = budget._parent)
+                    if (bytes > budget.Limit - budget._charged) failed = budget;
+            Interlocked.Exchange(ref failed._terminated, 1);
+            throw new ScriptExecutionAbortedException(ExecutionTerminationReason.MemoryLimit);
+        }
+
+        public AllocationReservation ReserveAllocation(long bytes)
+        {
+            if (!IsReclaimable) { Charge(bytes); return default; }
+            if (bytes < 0) throw new ArgumentOutOfRangeException(nameof(bytes));
+            if (bytes > long.MaxValue - RecordBytes) AbortDenied(long.MaxValue);
+            lock (_registry)
+            {
+                Check();
+                if (_registry.Count >= MaximumRecords) SweepLocked(MaximumRecords);
+                if (_registry.Count >= MaximumRecords) AbortDenied(long.MaxValue);
+                ReserveBytes(bytes + RecordBytes);
+                var allocation = new Allocation(this, bytes + RecordBytes);
+                Add(allocation);
+                return new AllocationReservation(allocation);
+            }
+        }
+
+        public void Track(object owner, long bytes)
+        {
+            if (owner == null) throw new ArgumentNullException(nameof(owner));
+            if (bytes < 0) throw new ArgumentOutOfRangeException(nameof(bytes));
+            Check();
+            if (!IsReclaimable) { Charge(bytes); return; }
+            lock (_registry)
+            {
+                if (_owners != null && _owners.TryGetValue(owner, out var existing))
+                {
+                    long additional = bytes - (existing.Bytes - RecordBytes);
+                    if (additional <= 0) return;
+                    using var growth = ReserveAllocation(additional);
+                    growth.Bind(owner);
+                    return;
+                }
+                using var reservation = ReserveAllocation(bytes);
+                reservation.BindUnique(owner);
+            }
+        }
+
+        public static void TrackObject(object owner, long bytes) { _current?.Track(owner, bytes); }
+        public static AllocationReservation Reserve(long bytes) => _current?.ReserveAllocation(bytes) ?? default;
+
+        public static AllocationReservation ReserveString(long characters)
+        {
+            if (_current == null) return default;
+            if (characters < 0 || characters > (long.MaxValue - 32) / 2)
+            {
+                Interlocked.Exchange(ref _current._terminated, 1);
+                _current.Check();
+            }
+            return _current.ReserveAllocation(32 + 2 * characters);
+        }
+
+        public static T Allocate<T>(long bytes, Func<T> factory) where T : class
+        {
+            if (_current == null) return factory();
+            using var reservation = _current.ReserveAllocation(bytes);
+            var result = factory();
+            if (result is Array array && array.Length == 0) return result;
+            reservation.BindUnique(result);
+            return result;
+        }
+
+        public static string AllocateString(long characters, Func<string> factory)
+        {
+            if (_current == null) return factory();
+            using var reservation = ReserveString(characters);
+            var result = factory();
+            if (!string.IsNullOrEmpty(result) && !ReferenceEquals(string.IsInterned(result), result))
+                reservation.BindUnique(result);
+            return result;
+        }
+
+        // Observation only: no forced game-wide GC, finalizers or user callbacks.
+        public int Sweep(int maxRecords = 1024)
+        {
+            if (maxRecords < 0 || maxRecords > MaximumRecords) throw new ArgumentOutOfRangeException(nameof(maxRecords));
+            lock (_registry) return SweepLocked(maxRecords);
+        }
+
+        private int SweepLocked(int maxRecords)
+        {
+            int inspect = Math.Min(maxRecords, _registry.Count), released = 0;
+            for (int index = 0; index < inspect; index++)
+            {
+                var allocation = _registry.Cursor ?? _registry.First;
+                if (allocation == null) break;
+                _registry.Cursor = allocation.Next ?? _registry.First;
+                // Long weak references retain credit through finalization/resurrection.
+                if (allocation.State == 1 && !allocation.Owner.TryGetTarget(out _))
+                {
+                    allocation.Budget.Release(allocation.Bytes, false);
+                    allocation.State = 2;
+                    Remove(allocation);
+                    released++;
+                }
+            }
+            return released;
+        }
+
+        private void Release(long bytes, bool unbound)
+        {
+            for (var budget = this; budget != null; budget = budget._parent)
+            {
+                budget._charged -= bytes;
+                if (unbound) budget._unbound -= bytes;
+            }
+        }
+
+        private void Bind(Allocation allocation, object owner, bool unique)
+        {
+            if (owner == null) throw new ArgumentNullException(nameof(owner));
+            lock (_registry)
+            {
+                if (allocation.State != 0) throw new InvalidOperationException("Reservation is already bound or cancelled.");
+                _owners ??= new ConditionalWeakTable<object, Allocation>();
+                if (_owners.TryGetValue(owner, out var existing))
+                {
+                    long additional = unique ? Math.Max(0, allocation.Bytes - existing.Bytes) : allocation.Bytes - RecordBytes;
+                    long released = allocation.Bytes - additional;
+                    for (var budget = this; budget != null; budget = budget._parent) budget._unbound -= allocation.Bytes;
+                    Release(released, false);
+                    existing.Bytes += additional;
+                    allocation.State = 2;
+                    Remove(allocation);
+                    return;
+                }
+                allocation.Owner = new WeakReference<object>(owner, true);
+                _owners.Add(owner, allocation);
+                allocation.State = 1;
+                for (var budget = this; budget != null; budget = budget._parent) budget._unbound -= allocation.Bytes;
+            }
+        }
+
+        private void Cancel(Allocation allocation)
+        {
+            lock (_registry)
+            {
+                if (allocation.State != 0) return;
+                Release(allocation.Bytes, true);
+                allocation.State = 2;
+                Remove(allocation);
+            }
+        }
+
+        private void Add(Allocation allocation)
+        {
+            allocation.Next = _registry.First;
+            if (_registry.First != null) _registry.First.Previous = allocation;
+            _registry.First = allocation;
+            _registry.Count++;
+        }
+
+        private void Remove(Allocation allocation)
+        {
+            if (_registry.Cursor == allocation) _registry.Cursor = allocation.Next ?? _registry.First;
+            if (allocation.Previous != null) allocation.Previous.Next = allocation.Next;
+            else _registry.First = allocation.Next;
+            if (allocation.Next != null) allocation.Next.Previous = allocation.Previous;
+            if (_registry.Cursor == allocation) _registry.Cursor = _registry.First;
+            allocation.Next = allocation.Previous = null;
+            _registry.Count--;
+        }
+
+        public Scope EnterScope() { Check(); return new Scope(this); }
+
+        public readonly struct Scope : IDisposable
+        {
+            private readonly MemoryBudget _previous;
+            internal Scope(MemoryBudget budget) { _previous = _current; _current = budget; }
+            public void Dispose() { _current = _previous; }
+        }
+
+        public readonly struct AllocationReservation : IDisposable
+        {
+            private readonly Allocation _allocation;
+            internal AllocationReservation(Allocation allocation) { _allocation = allocation; }
+            public void Bind(object owner) { _allocation?.Budget.Bind(_allocation, owner, false); }
+            internal void BindUnique(object owner) { _allocation?.Budget.Bind(_allocation, owner, true); }
+            public void Dispose() { _allocation?.Budget.Cancel(_allocation); }
+        }
+
+        internal sealed class Allocation
+        {
+            internal readonly MemoryBudget Budget;
+            internal long Bytes;
+            internal int State; // 0 reserved, 1 committed, 2 released
+            internal WeakReference<object> Owner;
+            internal Allocation Previous, Next;
+            internal Allocation(MemoryBudget budget, long bytes) { Budget = budget; Bytes = bytes; }
+        }
+
+        private sealed class Registry
+        {
+            internal Allocation First, Cursor;
+            internal int Count;
+        }
+    }
+}
