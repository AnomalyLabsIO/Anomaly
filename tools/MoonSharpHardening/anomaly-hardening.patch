diff --git a/src/DataStructs/BudgetedCollections.cs b/src/DataStructs/BudgetedCollections.cs
new file mode 100644
--- /dev/null
+++ b/src/DataStructs/BudgetedCollections.cs
@@ -0,0 +1,85 @@
+using System;
+using System.Collections.Generic;
+using System.Runtime.CompilerServices;
+
+namespace MoonSharp.Interpreter
+{
+    // Internal compiler containers only. Calls must retain these concrete types:
+    // List/Dictionary methods are not virtual. Backing arrays are private to the
+    // CLR collections, so conservative growth history stays with the container.
+    internal class BudgetedList<T> : List<T>
+    {
+        private readonly MemoryBudget _budget = MemoryBudget.Current;
+
+        internal BudgetedList() { _budget?.Track(this, 96); }
+
+        private void EnsureAdditional(int count)
+        {
+            int required = checked(Count + count);
+            if (required <= Capacity) return;
+            int capacity = Math.Max(required, Capacity > int.MaxValue / 2 ? int.MaxValue : Math.Max(4, Capacity * 2));
+            using var reservation = _budget?.ReserveAllocation(32L + (long)Unsafe.SizeOf<T>() * capacity);
+            EnsureCapacity(capacity);
+            reservation?.Bind(this);
+        }
+
+        public new void Add(T item) { EnsureAdditional(1); base.Add(item); }
+
+        public new void AddRange(IEnumerable<T> items)
+        {
+            if (items is ICollection<T> collection)
+            {
+                EnsureAdditional(collection.Count);
+                base.AddRange(collection);
+            }
+            else foreach (var item in items) Add(item);
+        }
+
+        public new T[] ToArray()
+        {
+            using var scope = _budget?.EnterScope();
+            return MemoryBudget.Allocate(32L + (long)Unsafe.SizeOf<T>() * Count, () => base.ToArray());
+        }
+    }
+
+    internal sealed class BudgetedDictionary<TKey, TValue> : Dictionary<TKey, TValue>
+    {
+        private readonly MemoryBudget _budget = MemoryBudget.Current;
+        private int _capacity;
+
+        internal BudgetedDictionary() { _budget?.Track(this, 128); }
+
+        public new void Add(TKey key, TValue value)
+        {
+            if (Count == _capacity)
+            {
+                int requested = _capacity > int.MaxValue / 2 ? int.MaxValue : Math.Max(4, _capacity * 2);
+                // Net6 prime sizing, buckets, entries and retained old arrays.
+                using var reservation = _budget?.ReserveAllocation(128L + (long)(128 + Unsafe.SizeOf<TKey>() + Unsafe.SizeOf<TValue>()) * 2 * requested);
+                _capacity = EnsureCapacity(requested);
+                reservation?.Bind(this);
+            }
+            base.Add(key, value);
+        }
+    }
+
+    internal sealed class BudgetedHashSet<T> : HashSet<T>
+    {
+        private readonly MemoryBudget _budget = MemoryBudget.Current;
+        private int _capacity;
+
+        internal BudgetedHashSet() { _budget?.Track(this, 128); }
+
+        public new bool Add(T value)
+        {
+            if (Count == _capacity)
+            {
+                int requested = _capacity > int.MaxValue / 2 ? int.MaxValue : Math.Max(4, _capacity * 2);
+                using var reservation = _budget?.ReserveAllocation(128L + (long)(96 + Unsafe.SizeOf<T>()) * 2 * requested);
+                _capacity = EnsureCapacity(requested);
+                reservation?.Bind(this);
+            }
+            return base.Add(value);
+        }
+    }
+}
diff --git a/src/DataStructs/BudgetedStringBuilder.cs b/src/DataStructs/BudgetedStringBuilder.cs
new file mode 100644
--- /dev/null
+++ b/src/DataStructs/BudgetedStringBuilder.cs
@@ -0,0 +1,40 @@
+using System;
+using System.Text;
+
+namespace MoonSharp.Interpreter
+{
+    // Lexer-only builder. Capacity is reserved before CLR buffer growth, while
+    // the final string receives a separate lease when it leaves the builder.
+    internal sealed class BudgetedStringBuilder
+    {
+        private readonly MemoryBudget _budget = MemoryBudget.Current;
+        private readonly StringBuilder _builder;
+
+        internal BudgetedStringBuilder(int capacity = 16)
+        {
+            _budget?.Track(this, 96);
+            _builder = MemoryBudget.Allocate(128L + 2L * capacity, () => new StringBuilder(capacity));
+        }
+
+        internal int Length => _builder.Length;
+
+        private void EnsureAdditional(int count)
+        {
+            long needed = (long)_builder.Length + count;
+            if (needed <= _builder.Capacity) return;
+            long capacity = Math.Max(needed, Math.Max(16L, 2L * _builder.Capacity));
+            using var reservation = _budget?.ReserveAllocation(128L + 4L * capacity);
+            _builder.EnsureCapacity(checked((int)capacity));
+            reservation?.Bind(_builder);
+        }
+
+        internal void Append(char value) { EnsureAdditional(1); _builder.Append(value); }
+        internal void Append(string value) { EnsureAdditional(value?.Length ?? 0); _builder.Append(value); }
+
+        public override string ToString()
+        {
+            using var scope = _budget?.EnterScope();
+            return MemoryBudget.AllocateString(_builder.Length, () => _builder.ToString());
+        }
+    }
+}
