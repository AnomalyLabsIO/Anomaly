<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>12</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Anomaly.RemoteScriptingSmoke.Server</AssemblyName>
  </PropertyGroup>
  <Import Project="..\..\..\samples\Anomaly.Server.Sample.props" />
  <ItemGroup>
    <Reference Include="System.Text.Json" HintPath="$(AnomalyServerReferenceDir)\System.Text.Json.dll" Private="false" />
    <Reference Include="System.Memory" HintPath="$(AnomalyServerReferenceDir)\System.Memory.dll" Private="false" />
    <Compile Include="..\..\ServerApiSmoke\SmokeMessages.cs" Link="SmokeMessages.cs" />
    <EmbeddedResource Include="ContentPacks\remote\pack.json" LogicalName="Anomaly.RemoteSmoke.Primary/pack.json" />
    <EmbeddedResource Include="ContentPacks\remote\scripts\main.lua" LogicalName="Anomaly.RemoteSmoke.Primary/scripts/main.lua" />
    <EmbeddedResource Include="ContentPacks\remote\scripts\messages.json" LogicalName="Anomaly.RemoteSmoke.Primary/scripts/messages.json" />
    <EmbeddedResource Include="ContentPacks\owner\pack.json" LogicalName="Anomaly.RemoteSmoke.Owner/pack.json" />
    <EmbeddedResource Include="ContentPacks\owner\scripts\main.lua" LogicalName="Anomaly.RemoteSmoke.Owner/scripts/main.lua" />
    <EmbeddedResource Include="ContentPacks\owner\scripts\messages.json" LogicalName="Anomaly.RemoteSmoke.Owner/scripts/messages.json" />
  </ItemGroup>
</Project>
