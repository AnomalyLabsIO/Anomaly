<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Anomaly.ScriptingCpuProbe</AssemblyName>
    <RootNamespace>Anomaly.ScriptingCpuProbe</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\third_party\MoonSharp\Anomaly.MoonSharp.Interpreter.csproj" />
    <ProjectReference Include="..\..\Anomaly.Client.Scripting\Anomaly.Client.Scripting.csproj" AdditionalProperties="DeployLocal=false" />
    <Reference Include="MelonLoader" HintPath="$(AnomalyClientMelonLibDir)\MelonLoader.dll" Private="true" />
  </ItemGroup>
</Project>
