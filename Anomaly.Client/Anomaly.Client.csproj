	<!--
	  Post-build deploy to the local test client's MelonLoader Mods folder. Override
	  $(AnomalyClientModsDir) via env var or a .csproj.user file to redirect.
	-->
	<PropertyGroup>
		<AnomalyClientModsDir Condition="'$(AnomalyClientModsDir)' == ''">E:\Projects\AnomalyLabs\ModdedFiles\loadouts\dev\local\Mods</AnomalyClientModsDir>
	</PropertyGroup>
	<Target Name="CopyToLocalClient" AfterTargets="Build">
		<Message Importance="high" Text="Anomaly.Client: copying $(TargetFileName) -&gt; $(AnomalyClientModsDir)" Condition="Exists('$(AnomalyClientModsDir)')" />
		<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(AnomalyClientModsDir)" SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" Condition="Exists('$(AnomalyClientModsDir)')" />
		<Warning Text="Anomaly.Client: AnomalyClientModsDir does not exist: $(AnomalyClientModsDir)" Condition="!Exists('$(AnomalyClientModsDir)')" />
	</Target>
