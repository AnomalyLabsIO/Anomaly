		<Compile Include="Patches\Input\FpcStateProcessorPatch.cs" />
		<Compile Include="Patches\Input\FpcJumpControllerPatch.cs" />
		<Compile Include="Patches\Input\FpcNoclipPatch.cs" />
		<Compile Include="Patches\Voice\VoiceMessageReadersWritersPatch.cs" />
		<Compile Include="Patches\Voice\VoiceTransceiverPatch.cs" />
		<Compile Include="Patches\Visibility\ClientVisibilityPatches.cs" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Anomaly.Shared\Anomaly.Shared.csproj"
	                    AdditionalProperties="DeployLocal=$(DeployLocal)" />
	  <ProjectReference Include="..\Anomaly.Client.Api\Anomaly.Client.Api.csproj"
	                    AdditionalProperties="DeployLocal=$(DeployLocal)" />
	</ItemGroup>

	<ItemGroup>
	  <!-- BigGustave + PngLoader have moved to Anomaly.Client.Api; this project
	       only needs HarmonyX for patches, MelonLoader for MelonMod lifecycle,
	       and Newtonsoft.Json for diagnostic/crash report serialization. -->
	  <PackageReference Include="HarmonyX" Version="2.16.0" />
	  <PackageReference Include="LavaGang.MelonLoader" Version="0.7.2" />
	  <PackageReference Include="Newtonsoft.Json" Version="13.0.5-beta1" />
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Include="Resources\i18n\*.yaml" />
	  <EmbeddedResource Include="Resources\PlayerCustomization\*.png" />
	</ItemGroup>
	
	<!--
	  Post-build deploy to the local test client's MelonLoader Mods folder. Override
	  $(AnomalyClientModsDir) via env var or a .csproj.user file to redirect.
	-->
	<PropertyGroup>
		<DeployLocal Condition="'$(DeployLocal)' == ''">false</DeployLocal>
	</PropertyGroup>
	<Target Name="CopyToLocalClient" AfterTargets="Build" Condition="'$(DeployLocal)' == 'true'">
		<Message Importance="high" Text="Anomaly.Client: copying $(TargetFileName) -&gt; $(AnomalyClientModsDir)" Condition="Exists('$(AnomalyClientModsDir)')" />
		<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(AnomalyClientModsDir)" SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" Condition="Exists('$(AnomalyClientModsDir)')" />
		<Warning Text="Anomaly.Client: AnomalyClientModsDir does not exist: $(AnomalyClientModsDir)" Condition="!Exists('$(AnomalyClientModsDir)')" />
	</Target>
</Project>
