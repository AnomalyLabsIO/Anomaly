    <TargetFramework>net48</TargetFramework>
    <LangVersion>12</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>HelloAnomalyServer</AssemblyName>
  </PropertyGroup>
  <Import Project="..\Anomaly.Server.Sample.props" />
  <ItemGroup>
    <Compile Include="..\HelloMessages.cs" Link="HelloMessages.cs" />
    <EmbeddedResource Include="ContentPacks\example\panel\pack.json" LogicalName="HelloAnomalyServer.Panel/pack.json" />
