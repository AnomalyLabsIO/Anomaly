<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.IO.Hashing" Version="8.0.0" />
    <!-- Needed for Windows Steam registry auto-detect. Safe to reference cross-platform —
         API throws PlatformNotSupportedException on Linux, which we catch in GameDetector. -->
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Il2CppDumper">
      <HintPath>Il2CppDumper\Il2CppDumper.dll</HintPath>
    </Reference>
    <Reference Include="Mono.Cecil">
      <HintPath>Il2CppDumper\Mono.Cecil.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Bootstrap fallbacks. The live copies of patchinfo.json and manifest.json live in
         AnomalyLabsIO/anomaly-resources and are fetched at install time; these embedded
         copies cover offline-first-run and are otherwise overridden by the live versions.
         unlicense.exe and SCPSL.exe used to be embedded too (~50 MB combined) — they're
         now downloaded on demand via AnomalyResourcesClient. -->
    <EmbeddedResource Include="Resources\patchinfo.json" />
    <EmbeddedResource Include="Resources\melonloader.json" />
    <EmbeddedResource Include="Resources\manifest.json" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Il2CppDumper\Il2CppDumper.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Il2CppDumper\Mono.Cecil.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Il2CppDumper\Mono.Cecil.Mdb.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Il2CppDumper\Mono.Cecil.Pdb.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Il2CppDumper\Mono.Cecil.Rocks.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
