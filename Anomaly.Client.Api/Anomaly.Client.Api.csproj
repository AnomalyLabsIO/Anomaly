		                  AdditionalProperties="DeployLocal=$(DeployLocal)" />
	</ItemGroup>

	<!--
	  Post-build deploy of Anomaly.Client.Api.dll to the local test client's
	  UserLibs/ folder (MelonLoader convention for mod-facing libraries).
	  Override $(AnomalyClientUserLibsDir) via env var or a .csproj.user file.
	-->
	<PropertyGroup>
		<DeployLocal Condition="'$(DeployLocal)' == ''">false</DeployLocal>
	</PropertyGroup>
	<Target Name="CopyApiToLocalClient" AfterTargets="Build" Condition="'$(DeployLocal)' == 'true'">
		<Message Importance="high" Text="Anomaly.Client.Api: copying $(TargetFileName) -&gt; $(AnomalyClientUserLibsDir)" Condition="Exists('$(AnomalyClientUserLibsDir)')" />
		<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(AnomalyClientUserLibsDir)" SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" Condition="Exists('$(AnomalyClientUserLibsDir)')" />
		<Warning Text="Anomaly.Client.Api: AnomalyClientUserLibsDir does not exist: $(AnomalyClientUserLibsDir)" Condition="!Exists('$(AnomalyClientUserLibsDir)')" />
		<Message Importance="high" Text="Anomaly.Client.Api: copying BigGustave.dll -&gt; $(AnomalyClientUserLibsDir)" Condition="Exists('$(AnomalyClientUserLibsDir)') And Exists('$(OutputPath)BigGustave.dll')" />
		<Copy SourceFiles="$(OutputPath)BigGustave.dll" DestinationFolder="$(AnomalyClientUserLibsDir)" SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" Condition="Exists('$(AnomalyClientUserLibsDir)') And Exists('$(OutputPath)BigGustave.dll')" />
		<Message Importance="high" Text="Anomaly.Client.Api: copying NVorbis.dll -&gt; $(AnomalyClientUserLibsDir)" Condition="Exists('$(AnomalyClientUserLibsDir)') And Exists('$(OutputPath)NVorbis.dll')" />
		<Copy SourceFiles="$(OutputPath)NVorbis.dll" DestinationFolder="$(AnomalyClientUserLibsDir)" SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" Condition="Exists('$(AnomalyClientUserLibsDir)') And Exists('$(OutputPath)NVorbis.dll')" />
		<Message Importance="high" Text="Anomaly.Client.Api: copying YamlDotNet.dll -&gt; $(AnomalyClientUserLibsDir)" Condition="Exists('$(AnomalyClientUserLibsDir)') And Exists('$(OutputPath)YamlDotNet.dll')" />
		<Copy SourceFiles="$(OutputPath)YamlDotNet.dll" DestinationFolder="$(AnomalyClientUserLibsDir)" SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" Condition="Exists('$(AnomalyClientUserLibsDir)') And Exists('$(OutputPath)YamlDotNet.dll')" />
	</Target>
</Project>
