	<ItemGroup>
		<!-- Pure-managed PNG decoder used by PngLoader. Zero native deps, ~20KB, MIT.
		     Required because UnityEngine.ImageConversion.LoadImage throws
		     MissingMethodException in this Il2CppInterop build. -->
		<PackageReference Include="BigGustave" Version="1.0.3" />
		<!-- Pure-managed OGG Vorbis decoder used by OggLoader. AOT-safe, MIT.
		     Used to materialize user/server-supplied .ogg overrides into AudioClip. -->
		<PackageReference Include="NVorbis" Version="0.10.5" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.5-beta1" />
		<!-- Managed YamlDotNet for LocalizationService (i18n YAML files). Version
		     pinned to match what SCPSL itself ships (11.0.x); the Il2CppYamlDotNet
		     reference above is the Il2Cpp wrapper used by game code, not callable
		     from managed mod code with generics. -->
		<PackageReference Include="YamlDotNet" Version="11.0.1" />
	</ItemGroup>

	<PropertyGroup>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
