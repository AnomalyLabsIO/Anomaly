<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit" Version="2.7.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.7" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\Anomaly.Client\Resources\i18n\*.yaml"
                      Link="Resources\i18n\%(Filename)%(Extension)"
                      LogicalName="Anomaly.Client.Resources.i18n.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Anomaly.Client.Api\Anomaly.Client.Api.csproj" AdditionalProperties="DeployLocal=false" />
    <Compile Include="..\Anomaly.Client\Internal\Modding\ModContext.cs" Link="Runtime\ModContext.cs" />
    <Compile Include="..\Anomaly.Client\Internal\Hosting\LocalHostGrantCoordinator.cs" Link="Runtime\LocalHostGrantCoordinator.cs" />
    <Compile Include="..\Anomaly.Client\Diagnostics\News\NewsDiagnosticModels.cs" Link="Runtime\News\NewsDiagnosticModels.cs" />
    <Compile Include="..\Anomaly.Client\Diagnostics\News\NewsLogParser.cs" Link="Runtime\News\NewsLogParser.cs" />
    <Compile Include="..\Anomaly.Client\Diagnostics\News\NewsMetadataInventory.cs" Link="Runtime\News\NewsMetadataInventory.cs" />
    <Compile Include="..\Anomaly.Client\Diagnostics\News\NewsHistoryReader.cs" Link="Runtime\News\NewsHistoryReader.cs" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(AnomalyClientInteropDir)\UnityEngine.CoreModule.dll" />
    <Reference Include="MelonLoader" HintPath="$(AnomalyClientMelonLibDir)\MelonLoader.dll" />
  </ItemGroup>
</Project>
