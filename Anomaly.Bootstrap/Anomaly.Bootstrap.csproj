<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Anomaly.Bootstrap</AssemblyName>
    <RootNamespace>Anomaly.Bootstrap</RootNamespace>
    <DeployLocal Condition="'$(DeployLocal)' == ''">false</DeployLocal>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="MelonLoader">
      <HintPath>$(AnomalyClientMelonLibDir)\MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(AnomalyClientMelonLibDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MonoMod.RuntimeDetour">
      <HintPath>$(AnomalyClientMelonLibDir)\MonoMod.RuntimeDetour.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MonoMod.Utils">
      <HintPath>$(AnomalyClientMelonLibDir)\MonoMod.Utils.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CopyBootstrapToLocalClient" AfterTargets="Build" Condition="'$(DeployLocal)' == 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(AnomalyClientPluginsDir)" SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" Condition="Exists('$(AnomalyClientPluginsDir)')" />
    <Warning Text="Anomaly.Bootstrap: AnomalyClientPluginsDir does not exist: $(AnomalyClientPluginsDir)" Condition="!Exists('$(AnomalyClientPluginsDir)')" />
  </Target>
</Project>
