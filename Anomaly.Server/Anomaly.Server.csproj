    <!--
      Post-build deploy to the local test server's LabAPI plugins folder. Override
      $(AnomalyPluginsDir) via env var or a .csproj.user file to redirect. Anomaly.Shared
      is deployed by its own post-build target so it isn't copied here.
    -->
    <Target Name="CopyToLocalServer" AfterTargets="Build">
      <Message Importance="high" Text="Anomaly.Server: copying $(TargetFileName) -&gt; $(AnomalyPluginsDir)" Condition="'$(DeployLocal)' == 'true' And Exists('$(AnomalyPluginsDir)')" />
      <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(AnomalyPluginsDir)" SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" Condition="'$(DeployLocal)' == 'true' And Exists('$(AnomalyPluginsDir)')" />
      <Warning Text="Anomaly.Server: AnomalyPluginsDir does not exist: $(AnomalyPluginsDir)" Condition="'$(DeployLocal)' == 'true' And !Exists('$(AnomalyPluginsDir)')" />
    </Target>
