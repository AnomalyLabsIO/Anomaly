    <!--
      Post-build deploy to the local test server's LabAPI dependencies folder and the
      local test client's MelonLoader UserLibs folder. Override $(AnomalyServerDepsDir)
      or $(AnomalyClientUserLibsDir) via env var or a .csproj.user file to redirect.
    -->
    <Target Name="CopySharedToLocalTargets" AfterTargets="Build">
      <Message Importance="high" Text="Anomaly.Shared: copying $(TargetFileName) -&gt; $(AnomalyServerDepsDir)" Condition="'$(DeployLocal)' == 'true' And Exists('$(AnomalyServerDepsDir)')" />
      <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(AnomalyServerDepsDir)" SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" Condition="'$(DeployLocal)' == 'true' And Exists('$(AnomalyServerDepsDir)')" />
      <Message Importance="high" Text="Anomaly.Shared: copying $(TargetFileName) -&gt; $(AnomalyClientUserLibsDir)" Condition="'$(DeployLocal)' == 'true' And Exists('$(AnomalyClientUserLibsDir)')" />
      <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(AnomalyClientUserLibsDir)" SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" Condition="'$(DeployLocal)' == 'true' And Exists('$(AnomalyClientUserLibsDir)')" />
      <Warning Text="Anomaly.Shared: AnomalyServerDepsDir does not exist: $(AnomalyServerDepsDir)" Condition="'$(DeployLocal)' == 'true' And !Exists('$(AnomalyServerDepsDir)')" />
      <Warning Text="Anomaly.Shared: AnomalyClientUserLibsDir does not exist: $(AnomalyClientUserLibsDir)" Condition="'$(DeployLocal)' == 'true' And !Exists('$(AnomalyClientUserLibsDir)')" />
    </Target>
